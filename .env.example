# ============================================================================
# FITMATE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` before running `docker compose up -d`.
# NEVER commit `.env` or real production secrets to Git.
# ============================================================================

# Application Metadata
APP_NAME=Size Recommendation API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Ports exposed by Docker Compose
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Persistent SQLite Database (stored inside the Docker volume mounted at /app/data)
DATABASE_URL=sqlite:////app/data/size_recommendation.db

# JWT Security (MUST be replaced with a 32+ character random secret in production)
JWT_SECRET_KEY=change-this-super-secret-jwt-key-in-production-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,chrome-extension://*

# Auth Rate Limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Machine Learning & Recommendation Config
ML_MODEL_PATH=app/ml/artifacts/size_model.joblib
ML_ENABLED=true
ML_MIN_CONFIDENCE=0.55
EASE_CONFIG_PATH=app/services/ease_config.json
