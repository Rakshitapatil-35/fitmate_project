APP_NAME="Size Recommendation API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL="sqlite:///./size_recommendation.db"

# JWT Security
JWT_SECRET_KEY="change-this-super-secret-jwt-key-in-production-min-32-bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins or JSON list; include chrome-extension://* for browser extension)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,chrome-extension://*"

# Rate Limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Machine Learning & Recommendation Config
ML_MODEL_PATH="app/ml/artifacts/size_model.joblib"
ML_ENABLED=true
ML_MIN_CONFIDENCE=0.55
EASE_CONFIG_PATH="app/services/ease_config.json"
LOG_LEVEL="INFO"
